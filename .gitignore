# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env: ignore secret-bearing base/local files (incl. pocketbase/.env with the
# OPENAI_API_KEY). The committed .env.development / .env.production hold only the
# public backend URL and ARE tracked.
**/.env
**/.env.*
**/.env.local
**/.env.*.local


# PocketBase runtime data + binary (keep pb_migrations/ and pb_hooks/ tracked)
/pb_data/
/pocketbase/pb_data/
/pocketbase/pocketbase
/pocketbase/pocketbase.exe

# Note: src/routeTree.gen.ts is generated by the TanStack Router plugin but is
# COMMITTED (not ignored) so `tsc` works on any clean checkout without first
# running a build. It regenerates on route changes — re-commit when it does.

# Android signing — NEVER commit
**/keystore.properties
*.jks
*.keystore

# graphify knowledge-graph output (generated, not committed)
graphify-out/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
